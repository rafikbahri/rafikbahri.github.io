---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  showImage?: boolean;
};

const { entry, showImage = false } = Astro.props as Props;
const image =
  showImage && entry.collection === "blog" ? entry.data.image : undefined;
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group flex flex-row overflow-hidden rounded-lg border border-black/15 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
>
  {
    image && (
      <img
        src={image}
        alt=""
        loading="lazy"
        class="aspect-[4/3] w-24 shrink-0 border-r border-black/15 bg-white bg-clip-padding object-cover transition-opacity duration-300 ease-in-out group-hover:opacity-90 sm:w-32 dark:border-white/20"
      />
    )
  }
  <div class="relative flex min-w-0 flex-1 flex-nowrap items-center px-4 py-3 pr-10">
    <div class:list={["flex flex-1 flex-col", image ? "min-w-0" : "truncate"]}>
      <div class="font-semibold">
        {entry.data.title}
      </div>
      <div class="text-sm">
        {entry.data.description}
      </div>
    </div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
    >
      <line
        x1="5"
        y1="12"
        x2="19"
        y2="12"
        class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
      ></line>
      <polyline
        points="12 5 19 12 12 19"
        class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
      ></polyline>
    </svg>
  </div>
</a>
